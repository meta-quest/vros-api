<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="?attr/colorSurface"
  android:orientation="vertical"
>
  <com.google.android.material.appbar.MaterialToolbar
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorPrimary"
    app:title="@string/stereo_video_title"
    app:titleTextColor="?attr/colorOnPrimary"
  />

  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
  >
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp"
    >
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stereo_mode_label"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface"
      />

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/stereo_type_radio_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:checkedButton="@id/radio_none"
        app:selectionRequired="true"
        app:singleSelection="true"
      >
        <com.google.android.material.button.MaterialButton
          android:id="@+id/radio_none"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/mode_mono"
        />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/radio_side_by_side"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/mode_side_by_side"
        />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/radio_top_bottom"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/mode_top_bottom"
        />
      </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>

  <com.google.android.material.card.MaterialCardView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginBottom="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginStart="16dp"
    android:layout_weight="1"
    app:cardBackgroundColor="#FF000000"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
  >
    <VideoView
      android:id="@+id/video_view"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center"
    />
  </com.google.android.material.card.MaterialCardView>

  <TextView
    android:id="@+id/composition_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginBottom="16dp"
    android:fontFamily="monospace"
    android:padding="12dp"
    android:background="#E6303030"
    android:textColor="#FFFFFFFF"
    android:textSize="12sp"
    android:text="@string/composition_info_placeholder"
  />
</LinearLayout>
